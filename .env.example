# Copy to .env for local runs. CHAOS_TOKEN has no default: the service refuses to start
# without one, so a publicly reachable instance cannot have its behaviour changed by a stranger.
CHAOS_TOKEN=replace-with-at-least-32-random-characters

PORT=8080
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

SERVICE_NAME=timeout-service
SERVICE_VERSION=1.0.0

# How long a request may spend waiting on the ledger before it is abandoned with a 504.
REQUEST_DEADLINE_MS=3000

# Baseline ledger latency, plus the jitter band applied to every call.
UPSTREAM_LATENCY_MS=200
UPSTREAM_JITTER_MS=80

# Fraction of ledger calls (0-1) that hang past the deadline regardless of the latency above.
UPSTREAM_TIMEOUT_RATE=0
